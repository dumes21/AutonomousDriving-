<mxfile host="app.diagrams.net"><diagram id="sac" name="SAC on JetRacer"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1790" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Soft Actor-Critic (SAC) on the JetRacer: from camera input to steering and throttle&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontSize=18;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1700" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Solid arrows: driving loop (every control step, ~22–35 Hz on the Jetson Nano).  Dashed arrows: learning (after each episode)." style="text;html=1;whiteSpace=wrap;fontSize=12;fontSize=12;align=center;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1700" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Onboard camera&lt;/b&gt;&lt;br&gt;320×240 RGB frame" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="150" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Pre-processing&lt;/b&gt;&lt;br&gt;resize to 160×120&lt;br&gt;crop top 40 rows&lt;br&gt;→ 160×80" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;VAE encoder (frozen)&lt;/b&gt;&lt;br&gt;4 conv layers&lt;br&gt;32 / 64 / 128 / 256 filters&lt;br&gt;→ latent mean μ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="400" y="105" width="175" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Latent vector z&lt;/b&gt;&lt;br&gt;32 values" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="605" y="120" width="140" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Action history&lt;/b&gt;&lt;br&gt;last 20 executed&lt;br&gt;(steering, throttle)&lt;br&gt;40 values" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="605" y="250" width="140" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;State sₜ&lt;/b&gt;&lt;br&gt;concatenate&lt;br&gt;32 + 40 =&lt;br&gt;&lt;b&gt;72 values&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="780" y="175" width="120" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Actor π (policy network)&lt;/b&gt;" style="swimlane;startSize=26;html=1;fontSize=13;rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFF8EE;" vertex="1" parent="1"><mxGeometry x="935" y="85" width="250" height="310" as="geometry"/></mxCell><mxCell id="c11" value="Dense 32 + ReLU" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="c10"><mxGeometry x="20" y="38" width="210" height="38" as="geometry"/></mxCell><mxCell id="c12" value="Dense 32 + ReLU" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="c10"><mxGeometry x="20" y="88" width="210" height="38" as="geometry"/></mxCell><mxCell id="c13" value="Gaussian heads&lt;br&gt;mean (2) and log-std (2)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="c10"><mxGeometry x="20" y="138" width="210" height="50" as="geometry"/></mxCell><mxCell id="c14" value="Sample a ~ N(mean, std)&lt;br&gt;(deterministic mean in demos)&lt;br&gt;squash with tanh, scale to&lt;br&gt;action limits" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="c10"><mxGeometry x="20" y="200" width="210" height="96" as="geometry"/></mxCell><mxCell id="c15" style="endArrow=block;endFill=1;html=1;strokeColor=#D79B00;" edge="1" parent="c10" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=block;endFill=1;html=1;strokeColor=#D79B00;" edge="1" parent="c10" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" style="endArrow=block;endFill=1;html=1;strokeColor=#D79B00;" edge="1" parent="c10" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Action aₜ&lt;/b&gt;&lt;br&gt;steering ∈ [−0.8, 0.8]&lt;br&gt;throttle ∈ [−1, 1]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1215" y="160" width="175" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Action processing&lt;/b&gt;&lt;br&gt;throttle → 0.3–0.4&lt;br&gt;(forward)&lt;br&gt;steering change&lt;br&gt;≤ 0.56 per step" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1420" y="150" width="175" height="130" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;JetRacer&lt;/b&gt;&lt;br&gt;steering servo&lt;br&gt;+ drive motor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1625" y="160" width="130" height="110" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c10" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="next camera frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c20" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="80"/><mxPoint x="95" y="80"/></Array></mxGeometry></mxCell><mxCell id="c31" value="executed action added to history" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="c19" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1507" y="365"/><mxPoint x="675" y="365"/></Array></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Human operator&lt;/b&gt;&lt;br&gt;START: begin episode&lt;br&gt;STOP: car leaving track" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1600" y="470" width="170" height="80" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Reward rₜ&lt;/b&gt;&lt;br&gt;each step: 1 + 0.1·(throttle/0.4)&lt;br&gt;on STOP: −10 − 5·(norm. throttle)&lt;br&gt;→ episode ends" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1370" y="460" width="200" height="100" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Replay buffer&lt;/b&gt; (30,000)&lt;br&gt;(sₜ, aₜ, rₜ, sₜ₊₁, done)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="260" height="80" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Twin critics Q₁, Q₂&lt;/b&gt;&lt;br&gt;input: state (72) + action (2)&lt;br&gt;Dense 32 → Dense 32 → Q-value&lt;br&gt;trained towards  y = r + γ [min Q̄(s′,a′) − α log π(a′|s′)]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="640" y="445" width="330" height="130" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Target critics Q̄₁, Q̄₂&lt;/b&gt;&lt;br&gt;slow copy, τ = 0.02" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="640" y="615" width="330" height="60" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;SAC update (after every episode)&lt;/b&gt;&lt;br&gt;200 gradient steps, batch 64&lt;br&gt;Adam, learning rate 3×10⁻⁴, γ = 0.99&lt;br&gt;entropy weight α tuned automatically (start 0.1)&lt;br&gt;300 random steps before learning starts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="220" y="455" width="360" height="140" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Actor objective:&lt;/b&gt; choose actions the critics rate highly while staying random enough to explore:&lt;br&gt;minimise  α log π(a|s) − min(Q₁, Q₂)(s, a)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="610" width="380" height="70" as="geometry"/></mxCell><mxCell id="c39" value="STOP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="store transition" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="c18" target="c34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="420"/><mxPoint x="1190" y="420"/></Array></mxGeometry></mxCell><mxCell id="c42" value="sample batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="c36" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="policy gradient (actor update)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="c35" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="420"/></Array></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="c37" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>